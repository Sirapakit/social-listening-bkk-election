# Copy this to .env and fill in your values.

# Apify API token — get yours at https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Apify actor for X.com scraping ($0.25 per 1k tweets, pay-per-result)
APIFY_ACTOR_ID=kaitoeasyapi/twitter-x-data-tweet-scraper-pay-per-result-cheapest

# Cost-control cap — max tweets per (keyword, day). Adjustable in the UI.
MAX_TWEETS_PER_KEYWORD=2000
PRICE_PER_TWEET_USD=0.00025

# Daily auto-scrape schedule. Set SCRAPE_SCHEDULE_HOUR=-1 to disable.
SCRAPE_SCHEDULE_HOUR=12
SCRAPE_SCHEDULE_MIN=0

# Default date window shown in the dashboard
DEFAULT_START_DATE=2026-05-01

# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_HOST_PORT=8001

# Frontend server
NEXT_PUBLIC_MOCK_DATA=false
# ── Owner deploy (full scraping access) ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and never committed.

APIFY_API_TOKEN=your_apify_api_token_here

# Set to false (or omit) for full scrape access
READONLY_MODE=false

# Scraping limits
MAX_TWEETS_PER_KEYWORD=2000

# Date window
DEFAULT_START_DATE=2026-05-01

# Cost per tweet (kaitoeasyapi pricing)
PRICE_PER_TWEET_USD=0.00025

# ── Viewer-only deploy (no scraping, no API token needed) ─────────────────────
# Uncomment and remove the lines above to deploy a read-only mirror.
#
# READONLY_MODE=true


# ── Frontend networking ────────────────────────────────────────────────────────
# The browser calls the backend directly, so this must be reachable from
# the end user's machine (not from inside Docker).
#
# Local deploy (default — both ports mapped to localhost):
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
#
# Remote server:
# NEXT_PUBLIC_BACKEND_URL=http://<your-server-ip>:8000
